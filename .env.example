# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
POSTGRES_USER=xeghep
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=xeghep
# DATABASE_URL is assembled from the above in docker-compose.yml automatically

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- PII field encryption (do NOT lose this key — encrypted data becomes
# unrecoverable without it. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" ---
PII_ENCRYPTION_KEY=replace_with_generated_fernet_key

# --- Goong Maps (https://goong.io) ---
GOONG_API_KEY=your_goong_api_key
GOONG_MAPTILES_KEY=your_goong_maptiles_key

# --- Zalo Official Account (optional) ---
# Leave EMPTY until an OA is actually registered for the business.
# Empty means customer messages are composed and queued for staff to
# relay by phone, which is how the business operates today. Setting a
# real token switches on automatic delivery — see
# backend/app/services/messaging.py for the remaining step (implementing
# ZaloChannel.send).
ZALO_OA_TOKEN=

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
